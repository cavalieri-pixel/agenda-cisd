generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Professional {
  id             Int            @id @default(autoincrement())
  name           String
  email          String         @unique
  password       String
  color          String         @default("#3788d8")
  phone          String?
  appointments   Appointment[]
  availabilities Availability[]
  createdAt      DateTime       @default(now())
}

model Service {
  id           Int           @id @default(autoincrement())
  name         String
  code         String        @unique
  durationMin  Int
  price        Int           // Precio base del servicio
  isTelemed    Boolean       @default(false)
  appointments Appointment[]
}

model Patient {
  id           Int           @id @default(autoincrement())
  rut          String        @unique
  name         String
  email        String
  phone        String?
  appointments Appointment[]
}

model Appointment {
  id             Int          @id @default(autoincrement())
  startTime      DateTime
  endTime        DateTime
  status         String       @default("CONFIRMED")
  
  // --- CAMPOS FINANCIEROS (MERCADOPAGO) ---
  price          Int          @default(0)           // Precio congelado al momento de la reserva
  paymentStatus  String       @default("PENDING")   // PENDING, PAID, REJECTED
  paymentMethod  String?                            // Ej: "MERCADOPAGO", "TRANSFERENCIA", "EFECTIVO"
  mpPreferenceId String?                            // ID de la intención de pago (para el link)
  mpPaymentId    String?                            // ID del comprobante final de MP
  // ----------------------------------------

  // --- FICHA CLÍNICA ---
  clinicalNote   String?      @db.Text
  // ---------------------

  professionalId Int
  professional   Professional @relation(fields: [professionalId], references: [id])
  
  patientId      Int
  patient        Patient      @relation(fields: [patientId], references: [id])
  
  serviceId      Int
  service        Service      @relation(fields: [serviceId], references: [id])

  meetLink       String?
  googleEventId  String?

  createdAt      DateTime     @default(now())
}

model Availability {
  id             Int          @id @default(autoincrement())
  dayOfWeek      Int
  startTime      String
  endTime        String
  
  professionalId Int
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}