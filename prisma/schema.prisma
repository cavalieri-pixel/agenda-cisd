// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Professional {
  id           Int            @id @default(autoincrement())
  name         String
  email        String         @unique
  password     String
  color        String         @default("#3788d8") // Para el calendario
  phone        String?
  appointments Appointment[]
  
  // Relación con Horarios Disponibles (NUEVO)
  availabilities Availability[] 
  
  createdAt    DateTime       @default(now())
}

model Service {
  id           Int           @id @default(autoincrement())
  name         String
  code         String        @unique // Ejemplo: "KINE-RESP"
  durationMin  Int           // Duración en minutos
  price        Int           // Precio en CLP
  isTelemed    Boolean       @default(false)
  appointments Appointment[]
}

model Patient {
  id           Int           @id @default(autoincrement())
  rut          String        @unique
  name         String
  email        String
  phone        String?
  appointments Appointment[]
}

model Appointment {
  id             Int          @id @default(autoincrement())
  startTime      DateTime
  endTime        DateTime
  status         String       @default("CONFIRMED") // CONFIRMED, CANCELLED, COMPLETED
  
  professionalId Int
  professional   Professional @relation(fields: [professionalId], references: [id])
  
  patientId      Int
  patient        Patient      @relation(fields: [patientId], references: [id])
  
  serviceId      Int
  service        Service      @relation(fields: [serviceId], references: [id])

  meetLink       String?      // Link de Google Meet
  googleEventId  String?      // ID del evento en Google Calendar

  createdAt      DateTime     @default(now())
}

// --- NUEVO MODELO: DISPONIBILIDAD ---
// Define qué días y horas trabaja un profesional
model Availability {
  id             Int          @id @default(autoincrement())
  dayOfWeek      Int          // 0=Domingo, 1=Lunes, ... 6=Sábado
  startTime      String       // Ejemplo: "09:00"
  endTime        String       // Ejemplo: "13:00"
  
  professionalId Int
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}