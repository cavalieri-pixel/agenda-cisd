generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Professional {
  id             Int            @id @default(autoincrement())
  name           String
  email          String         @unique
  password       String
  color          String         @default("#3788d8")
  phone          String?
  
  // Intervalo entre citas (minutos)
  slotInterval   Int            @default(30) 

  appointments   Appointment[]
  availabilities Availability[]
  createdAt      DateTime       @default(now())
}

model Service {
  id            Int           @id @default(autoincrement())
  
  // --- DATOS DE TRATAMIENTO ---
  category      String?       @default("General") 
  specialty     String?       
  name          String
  code          String        @unique
  price         Int
  discountValue Int           @default(0) 
  description   String?       @db.Text    
  // --------------------------

  durationMin   Int           @default(30)
  isTelemed     Boolean       @default(false)
  
  appointments  Appointment[]
}

model Patient {
  id           Int           @id @default(autoincrement())
  rut          String        @unique
  name         String
  email        String
  phone        String?
  
  // --- DATOS PACIENTE ---
  address      String?
  prevision    String?       
  birthDate    DateTime?
  // --------------------

  appointments Appointment[]
}

model Appointment {
  id             Int          @id @default(autoincrement())
  startTime      DateTime
  endTime        DateTime
  status         String       @default("CONFIRMED") // "CONFIRMED", "CANCELLED", "BLOCKED"
  
  // Nuevo: Título para el bloqueo (ej: "Almuerzo", "Vacaciones")
  title          String?      

  price          Int          @default(0)
  paymentStatus  String       @default("PENDING")
  paymentMethod  String?      
  mpPreferenceId String?      
  mpPaymentId    String?      

  // Clínico
  clinicalNote   String?      @db.Text

  professionalId Int
  professional   Professional @relation(fields: [professionalId], references: [id])
  
  // RELACIONES OPCIONALES (Para permitir bloqueos sin paciente)
  patientId      Int?
  patient        Patient?     @relation(fields: [patientId], references: [id])
  
  serviceId      Int?
  service        Service?     @relation(fields: [serviceId], references: [id])

  meetLink       String?
  googleEventId  String?

  createdAt      DateTime     @default(now())
}

model Availability {
  id             Int          @id @default(autoincrement())
  dayOfWeek      Int
  startTime      String
  endTime        String
  
  professionalId Int
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}